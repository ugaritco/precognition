{
  "name": "ugarit-precognition-alpine",
  "version": "1.00.00",
  "description": "Ugarit Precognition (Alpine).",
  "keywords": [
    "ugarit",
    "precognition",
    "alpine"
  ],
  "homepage": "https://github.com/ugarit/precognition",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugarit/precognition"
  },
  "license": "MIT",
  "author": "Ugarit",
  "main": "dist/index.js",
  "files": [
    "/dist"
  ],
  "scripts": {
    "watch": "rm -rf dist && tsc --watch --preserveWatchOutput",
    "build": "rm -rf dist && tsc",
    "typeCheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "version": "npm pkg set dependencies.ugarit-precognition=$npm_package_version"
  },
  "peerDependencies": {
    "alpinejs": "^3.12.1"
  },
  "dependencies": {
    "es-toolkit": "^1.32.0",
    "ugarit-precognition": "2.0.0"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.7.1",
    "typescript": "^5.0.0"
  }
}
